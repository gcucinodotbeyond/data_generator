{# VARIABLES: sentiment (positive/negative/neutral), rudeness, verbose #}

{%- set farewells = [
    "Arrivederci", "Addio", "A presto", "Ciao", "Buona giornata", "Buona serata", 
    "Alla prossima", "Ci vediamo", "Stammi bene", "Saluti", "Buon proseguimento", 
    "È tutto per ora", "Chiudo qui", "Buon lavoro", "Ci sentiamo", "A più tardi",
    "Stacca pure", "Grazie ciao", "Saluti a tutti", "Buon viaggio anche a te"
] -%}

{%- set thanks = [
    "Grazie", "Grazie mille", "Grazie di tutto", "Ti ringrazio", "Molto gentile", 
    "Gentilissimo", "Grazie infinite", "Perfetto grazie", "Ok grazie", "Grazie del supporto",
    "Grazie dell'aiuto", "Tante grazie", "Davvero gentile"
] -%}

{%- set pos_feedback = [
    "Sei stato molto utile", "Ottimo servizio", "Veloce e preciso", "Funziona bene", 
    "Molto efficiente", "Mi hai aiutato molto", "Servizio eccellente", "Tutto perfetto",
    "Sei un grande", "Mitico", "Bravissimo", "Assistenza top"
] -%}

{%- set neg_feedback = [
    "Non funziona mai nulla", "Pessimo servizio", "Troppo lento", "Non ho capito niente", 
    "È stato difficile", "Interfaccia confusa", "Non sei d'aiuto", "Esperienza negativa",
    "Che fatica", "Inutile", "Sistema scadente"
] -%}

{# --- CONCISE FAREWELL --- #}
{% if verbose == 'concise' %}
    {% if sentiment == 'positive' %}
{{ to_json({"text": "Grazie", "variables": {}}) }}
{{ to_json({"text": "Ok", "variables": {}}) }}
{{ to_json({"text": "Top", "variables": {}}) }}
{{ to_json({"text": "Bene", "variables": {}}) }}
    {% else %}
{{ to_json({"text": "Ciao", "variables": {}}) }}
{{ to_json({"text": "Arrivederci", "variables": {}}) }}
{{ to_json({"text": "Basta", "variables": {}}) }}
    {% endif %}
{% endif %}

{# --- VERBOSE FAREWELL --- #}
{% if verbose == 'verbose' %}
    {% if sentiment == 'positive' %}
{{ to_json({"text": "Ti ringrazio davvero di cuore per tutto l'aiuto che mi hai dato oggi, sei stato prezioso. Buona giornata!", "variables": {}}) }}
{{ to_json({"text": "Tutto perfetto, grazie mille ancora per la pazienza e per le informazioni dettagliate. Alla prossima!", "variables": {}}) }}
{{ to_json({"text": "Sei stato gentilissimo, ho risolto tutti i miei dubbi. Grazie e buon lavoro!", "variables": {}}) }}
    {% else %}
{{ to_json({"text": "D'accordo, per ora direi che ho tutte le informazioni di cui avevo bisogno. Grazie e a risentirci presto.", "variables": {}}) }}
{{ to_json({"text": "Va bene così, non aggiungere altro. Ti ringrazio per il supporto e ti auguro un buon proseguimento di giornata.", "variables": {}}) }}
{{ to_json({"text": "Onestamente mi aspettavo di fare prima, ma ok, grazie lo stesso.", "variables": {}}) }}
    {% endif %}
{% endif %}

{# --- STANDARD FAREWELLS --- #}
{% if verbose == 'standard' %}
    {# --- SIMPLE FAREWELL --- #}
    {%- for word in farewells %}
{{ to_json({"text": word, "variables": {}}) }}
    {% endfor %}

    {# --- THANKS + FAREWELL --- #}
    {%- for t in thanks %}
{{ to_json({"text": t, "variables": {}}) }}
    {% endfor %}

    {%- for t in thanks %}
    {%- for f in farewells %}
{{ to_json({"text": t ~ ", " ~ f|lower, "variables": {}}) }}
{{ to_json({"text": t ~ ". " ~ f, "variables": {}}) }}
    {% endfor %}
    {% endfor %}

    {# --- POSITIVE FEEDBACK COMBINATIONS --- #}
    {% if sentiment == 'positive' %}
    {%- for p in pos_feedback %}
    {%- for f in farewells %}
{{ to_json({"text": p ~ ". " ~ f, "variables": {}}) }}
    {% endfor %}
    {% endfor %}
    {% endif %}

    {# --- NEGATIVE FEEDBACK COMBINATIONS (Polite/Neutral) --- #}
    {% if sentiment == 'negative' %}
    {%- for n in neg_feedback %}
    {%- for f in farewells %}
{{ to_json({"text": n ~ ". " ~ f, "variables": {}}) }}
    {% endfor %}
    {% endfor %}
    {% endif %}

    {% if rudeness == 'polite' %}
{{ to_json({"text": "Grazie infinite per l'aiuto, buona giornata!", "variables": {}}) }}
{{ to_json({"text": "La ringrazio molto, arrivederci.", "variables": {}}) }}
{{ to_json({"text": "Molto gentile, a presto.", "variables": {}}) }}
    {% else %} {# neutral #}
{{ to_json({"text": "Basta così", "variables": {}}) }}
{{ to_json({"text": "Non mi serve altro", "variables": {}}) }}
{{ to_json({"text": "Ho finito", "variables": {}}) }}
    {% endif %}
{% endif %}
