{# VARIABLES: action (next, prev, back, status, show_changes), rudeness, verbose, target_train, position_word #}

{%- if action == "next" %}
    {% if verbose == 'concise' %}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Avanti grazie", "variables": {}}) }}
            {{ to_json({"text": "Altro per favore", "variables": {}}) }}
            {{ to_json({"text": "Prossimi", "variables": {}}) }}
            {{ to_json({"text": "Giù per favore", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Avanti", "variables": {}}) }}
            {{ to_json({"text": "Altri", "variables": {}}) }}
            {{ to_json({"text": "Successivi", "variables": {}}) }}
            {{ to_json({"text": "Più giù", "variables": {}}) }}
            {{ to_json({"text": "Scorri", "variables": {}}) }}
            {{ to_json({"text": "Seguenti", "variables": {}}) }}
        {% endif %}
    {% elif verbose == 'verbose' %}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Saresti così gentile da mostrarmi le opzioni successive della lista?", "variables": {}}) }}
            {{ to_json({"text": "Per favore, potresti farmi vedere se ci sono altre soluzioni dopo queste?", "variables": {}}) }}
            {{ to_json({"text": "Vorrei vedere i prossimi treni nell'elenco, se possibile.", "variables": {}}) }}
            {{ to_json({"text": "Mi mostri gentilmente cos'altro c'è più avanti?", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Fammi vedere i prossimi treni perché questi non mi convincono molto.", "variables": {}}) }}
            {{ to_json({"text": "Sposta la pagina in avanti per vedere le partenze successive.", "variables": {}}) }}
            {{ to_json({"text": "Mostrami i risultati dopo questi, voglio vedere cos'altro c'è.", "variables": {}}) }}
            {{ to_json({"text": "Scorri la lista, voglio vedere le opzioni seguenti.", "variables": {}}) }}
        {% endif %}
    {% else %} {# standard #}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Vai avanti per favore", "variables": {}}) }}
            {{ to_json({"text": "Mostrami i prossimi, grazie", "variables": {}}) }}
            {{ to_json({"text": "C'è altro dopo per favore?", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Vai avanti", "variables": {}}) }}
            {{ to_json({"text": "Mostrami i prossimi risultati", "variables": {}}) }}
            {{ to_json({"text": "Scendi ancora", "variables": {}}) }}
            {{ to_json({"text": "Fammi vedere altri treni", "variables": {}}) }}
            {{ to_json({"text": "Pagina seguente", "variables": {}}) }}
        {% endif %}
    {% endif %}

{%- elif action == "prev" %}
    {% if verbose == 'concise' %}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Indietro grazie", "variables": {}}) }}
            {{ to_json({"text": "Prima per favore", "variables": {}}) }}
            {{ to_json({"text": "Pagina precedente grazie", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Indietro", "variables": {}}) }}
            {{ to_json({"text": "Prima", "variables": {}}) }}
            {{ to_json({"text": "Pagina precedente", "variables": {}}) }}
            {{ to_json({"text": "Quelli di prima", "variables": {}}) }}
            {{ to_json({"text": "Quelle di prima", "variables": {}}) }}
            {{ to_json({"text": "Torna su", "variables": {}}) }}
        {% endif %}
    {% elif verbose == 'verbose' %}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Potresti cortesemente tornare alla schermata precedente? Vorrei ricontrollare i primi risultati.", "variables": {}}) }}
            {{ to_json({"text": "Saresti così gentile da mostrarmi di nuovo i treni che abbiamo visto poco fa?", "variables": {}}) }}
            {{ to_json({"text": "Se non disturbo, vorrei tornare indietro di una pagina.", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Torna a quelli di prima, volevo rivedere meglio le prime soluzioni che hai trovato.", "variables": {}}) }}
            {{ to_json({"text": "Vai indietro perché mi sembra che i primi treni fossero più convenienti.", "variables": {}}) }}
            {{ to_json({"text": "Mostrami di nuovo la lista precedente, per favore.", "variables": {}}) }}
        {% endif %}
    {% else %} {# standard #}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Torna a quelli di prima per favore", "variables": {}}) }}
            {{ to_json({"text": "Vai indietro grazie", "variables": {}}) }}
            {{ to_json({"text": "Vorrei rivedere quelli precedenti", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Torna a quelli di prima", "variables": {}}) }}
            {{ to_json({"text": "Vai indietro", "variables": {}}) }}
            {{ to_json({"text": "Mostrami i precedenti", "variables": {}}) }}
            {{ to_json({"text": "Voglio rivedere quelli prima", "variables": {}}) }}
        {% endif %}
    {% endif %}

{%- elif action == "back" %}
    {% if verbose == 'concise' %}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Annulla grazie", "variables": {}}) }}
            {{ to_json({"text": "Inizio per favore", "variables": {}}) }}
            {{ to_json({"text": "Reset", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Annulla", "variables": {}}) }}
            {{ to_json({"text": "Inizio", "variables": {}}) }}
            {{ to_json({"text": "Reset", "variables": {}}) }}
            {{ to_json({"text": "Esci", "variables": {}}) }}
            {{ to_json({"text": "Home", "variables": {}}) }}
        {% endif %}
    {% elif verbose == 'verbose' %}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Scusa, avrei bisogno di ricominciare la ricerca dall'inizio, potresti aiutarmi?", "variables": {}}) }}
            {{ to_json({"text": "Sarebbe possibile annullare tutto e tornare alla pagina principale?", "variables": {}}) }}
            {{ to_json({"text": "Vorrei cambiare tutto e ripartire da zero, se non è un problema.", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Annulla tutto e ricomincia da capo, ho cambiato idea sul viaggio.", "variables": {}}) }}
            {{ to_json({"text": "Basta così, torna all'inizio che devo inserire dati diversi.", "variables": {}}) }}
            {{ to_json({"text": "Voglio resettare la ricerca e farne una nuova.", "variables": {}}) }}
        {% endif %}
    {% else %} {# standard #}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Annulla tutto per favore", "variables": {}}) }}
            {{ to_json({"text": "Vorrei tornare all'inizio se possibile", "variables": {}}) }}
            {{ to_json({"text": "Possiamo ricominciare da capo?", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Annulla tutto", "variables": {}}) }}
            {{ to_json({"text": "Torna all'inizio", "variables": {}}) }}
            {{ to_json({"text": "Ricomincia da capo", "variables": {}}) }}
            {{ to_json({"text": "Voglio rifare la ricerca", "variables": {}}) }}
            {{ to_json({"text": "Reset completo", "variables": {}}) }}
        {% endif %}
    {% endif %}

{%- elif action == "status" %}
    {% if verbose == 'concise' %}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Stato grazie", "variables": {}}) }}
            {{ to_json({"text": "Riepilogo per favore", "variables": {}}) }}
            {{ to_json({"text": "Info", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Stato?", "variables": {}}) }}
            {{ to_json({"text": "Riepilogo", "variables": {}}) }}
            {{ to_json({"text": "Checkout?", "variables": {}}) }}
            {{ to_json({"text": "Info", "variables": {}}) }}
        {% endif %}
    {% elif verbose == 'verbose' %}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Potresti gentilmente farmi un riepilogo di quello che ho selezionato finora per favore?", "variables": {}}) }}
            {{ to_json({"text": "Saresti così cortese da dirmi a che punto è la mia prenotazione?", "variables": {}}) }}
            {{ to_json({"text": "Per favore, mi ricapitoli i dettagli del viaggio che ho scelto?", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Voglio vedere il riepilogo del mio ordine prima di procedere.", "variables": {}}) }}
            {{ to_json({"text": "Fammi vedere bene cosa ho scelto e quanto sto spendendo.", "variables": {}}) }}
            {{ to_json({"text": "Dimmi a che punto siamo con la selezione del biglietto.", "variables": {}}) }}
        {% endif %}
    {% else %} {# standard #}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "A che punto siamo per favore?", "variables": {}}) }}
            {{ to_json({"text": "Mi fai un riepilogo grazie?", "variables": {}}) }}
            {{ to_json({"text": "Cosa ho selezionato finora?", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "A che punto siamo?", "variables": {}}) }}
            {{ to_json({"text": "Fammi un riepilogo", "variables": {}}) }}
            {{ to_json({"text": "Cosa ho selezionato?", "variables": {}}) }}
            {{ to_json({"text": "Dimmi cosa sto comprando", "variables": {}}) }}
        {% endif %}
    {% endif %}

{%- elif action == "show_info" %}
    {%- if target == "train" %}
        {% if verbose == 'concise' %}
            {% if rudeness == 'polite' %}
                {{ to_json({"text": "Cambi grazie", "variables": {}}) }}
                {{ to_json({"text": "Diretto per favore?", "variables": {}}) }}
                {{ to_json({"text": "Fermate", "variables": {}}) }}
                {{ to_json({"text": "Info treno", "variables": {}}) }}
            {% else %}
                {{ to_json({"text": "Cambi?", "variables": {}}) }}
                {{ to_json({"text": "Diretto?", "variables": {}}) }}
                {{ to_json({"text": "Fermate?", "variables": {}}) }}
                {{ to_json({"text": "Soste?", "variables": {}}) }}
            {% endif %}
        {% elif verbose == 'verbose' %}
            {% if rudeness == 'polite' %}
                {% if target_train %}
                    {{ to_json({"text": "Sapresti dirmi se questo treno prevede dei cambi o delle fermate intermedie, per favore?", "variables": {}}) }}
                    {{ to_json({"text": "Saresti così gentile da controllare se il viaggio è diretto?", "variables": {}}) }}
                    {{ to_json({"text": "Vorrei sapere se ci sono delle soste lungo il tragitto, grazie.", "variables": {}}) }}
                {% elif position_word %}
                    {{ to_json({"text": "Saresti così gentile da dirmi se il " ~ position_word ~ " treno ha dei cambi?", "variables": {}}) }}
                {% endif %}
            {% else %} {# neutral #}
                {% if target_train %}
                    {{ to_json({"text": "Questo treno ha dei cambi o delle fermate intermedie che dovrei conoscere?", "variables": {}}) }}
                    {{ to_json({"text": "Volevo sapere se il risultato della lista è un treno diretto o se devo scendere.", "variables": {}}) }}
                    {{ to_json({"text": "Fammi vedere l'elenco delle fermate di questa soluzione.", "variables": {}}) }}
                {% elif position_word %}
                    {{ to_json({"text": "Volevo sapere se il " ~ position_word ~ " risultato della lista è un treno diretto.", "variables": {}}) }}
                {% endif %}
            {% endif %}
        {% else %} {# standard #}
            {% if rudeness == 'polite' %}
                {% if target_train %}
                    {{ to_json({"text": "Questo treno ha cambi, per favore?", "variables": {}}) }}
                    {{ to_json({"text": "È diretto per caso?", "variables": {}}) }}
                    {{ to_json({"text": "Mi dici dove si ferma, grazie?", "variables": {}}) }}
                {% elif position_word %}
                    {{ to_json({"text": "Il " ~ position_word ~ " ha cambi per favore?", "variables": {}}) }}
                {% endif %}
            {% else %} {# neutral #}
                {% if target_train %}
                    {{ to_json({"text": "Questo treno ha cambi?", "variables": {}}) }}
                    {{ to_json({"text": "È diretto?", "variables": {}}) }}
                    {{ to_json({"text": "Dove si ferma?", "variables": {}}) }}
                    {{ to_json({"text": "Ci sono coincidenze?", "variables": {}}) }}
                {% elif position_word %}
                    {{ to_json({"text": "Il " ~ position_word ~ " ha cambi?", "variables": {}}) }}
                    {{ to_json({"text": "Il " ~ position_word ~ " è diretto?", "variables": {}}) }}
                {% endif %}
            {% endif %}
        {% endif %}

    {%- elif target == "station" %}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Dove sono i bagni per favore?", "variables": {}}) }}
            {{ to_json({"text": "Scusa, dov'è la biglietteria?", "variables": {}}) }}
            {{ to_json({"text": "Mi dai info sulla stazione?", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Dove sono i bagni?", "variables": {}}) }}
            {{ to_json({"text": "Dov'è la biglietteria?", "variables": {}}) }}
            {{ to_json({"text": "Info stazione", "variables": {}}) }}
            {{ to_json({"text": "Servizi stazione", "variables": {}}) }}
        {% endif %}

    {%- elif target == "city" %}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Come arrivo in centro per favore?", "variables": {}}) }}
            {{ to_json({"text": "Cosa posso vedere qui vicino?", "variables": {}}) }}
            {{ to_json({"text": "Dov'è l'ufficio turistico grazie?", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Come arrivo in centro?", "variables": {}}) }}
            {{ to_json({"text": "Cosa posso vedere?", "variables": {}}) }}
            {{ to_json({"text": "Dov'è l'ufficio turistico?", "variables": {}}) }}
            {{ to_json({"text": "Info città", "variables": {}}) }}
        {% endif %}

    {%- elif target == "help" %}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Come funziona per favore?", "variables": {}}) }}
            {{ to_json({"text": "Mi aiuti a capire come si usa?", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Come funziona?", "variables": {}}) }}
            {{ to_json({"text": "Aiuto", "variables": {}}) }}
            {{ to_json({"text": "Istruzioni", "variables": {}}) }}
        {% endif %}

    {%- elif target == "ticket" %}
        {% if rudeness == 'polite' %}
            {{ to_json({"text": "Mostrami il biglietto grazie", "variables": {}}) }}
            {{ to_json({"text": "Dettagli acquisto per favore", "variables": {}}) }}
        {% else %}
            {{ to_json({"text": "Mostra il biglietto", "variables": {}}) }}
            {{ to_json({"text": "Dettagli acquisto", "variables": {}}) }}
            {{ to_json({"text": "Vedi biglietto", "variables": {}}) }}
        {% endif %}
    {%- endif %}

{%- else %}
    {{ to_json({"text": "Menu", "variables": {}}) }}
    {{ to_json({"text": "Aiuto", "variables": {}}) }}
{%- endif %}
