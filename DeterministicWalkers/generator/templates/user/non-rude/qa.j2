{# VARIABLES: pet, luggage, service, topic, rudeness, verbose #}

{# --- PETS --- #}
{% if pet or topic == 'pets' %}
{% set p = pet or "cane" %}
{% if verbose == 'concise' %}
{{ to_json({"text": p ~ "?", "variables": {"topic": "pets"}}) }}
{{ to_json({"text": "Posto " ~ p ~ "?", "variables": {"topic": "pets"}}) }}
{% elif verbose == 'verbose' %}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Mi scusi per il disturbo, saprebbe per caso dirmi se il mio piccolo " ~ p ~ " può viaggiare con me sul vagoni?", "variables": {"topic": "pets"}}) }}
    {% else %}
{{ to_json({"text": "Volevo chiederti un'informazione sugli animali: è possibile portare il mio " ~ p ~ " a bordo del treno che ho selezionato?", "variables": {"topic": "pets"}}) }}
    {% endif %}
{% else %} {# standard #}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Mi scusi, saprebbe dirmi se il mio " ~ p ~ " può viaggiare con me?", "variables": {"topic": "pets"}}) }}
{{ to_json({"text": "Sarebbe così gentile da confermarmi se il " ~ p ~ " paga il biglietto?", "variables": {"topic": "pets"}}) }}
    {% else %} {# neutral #}
{{ to_json({"text": "Posso portare il mio " ~ p ~ "?", "variables": {"topic": "pets"}}) }}
{{ to_json({"text": "Si paga per il " ~ p ~ "?", "variables": {"topic": "pets"}}) }}
    {% endif %}
{% endif %}
{% endif %}

{# --- LUGGAGE --- #}
{% if luggage or topic == 'luggage' %}
{% set l = luggage or "zaino" %}
{% if verbose == 'concise' %}
{{ to_json({"text": "Spazio " ~ l ~ "?", "variables": {"topic": "luggage"}}) }}
{{ to_json({"text": "Posto " ~ l ~ "?", "variables": {"topic": "luggage"}}) }}
{% elif verbose == 'verbose' %}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Mi scusi, avrei bisogno di un'indicazione: saprebbe dirmi se c'è un'area riservata per posare " ~ l ~ " ingombranti?", "variables": {"topic": "luggage"}}) }}
    {% else %}
{{ to_json({"text": "Stavo cercando di capire se c'è abbastanza spazio per il mio " ~ l ~ " o se devo stare attento a dove lo metto.", "variables": {"topic": "luggage"}}) }}
    {% endif %}
{% else %} {# standard #}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Saprebbe indicarmi gentilmente dove posare " ~ l ~ "?", "variables": {"topic": "luggage"}}) }}
{{ to_json({"text": "Mi scusi, c'è un'area dedicata per " ~ l ~ "?", "variables": {"topic": "luggage"}}) }}
    {% else %} {# neutral #}
{{ to_json({"text": "Dove metto " ~ l ~ "?", "variables": {"topic": "luggage"}}) }}
{{ to_json({"text": "C'è spazio per " ~ l ~ "?", "variables": {"topic": "luggage"}}) }}
    {% endif %}
{% endif %}
{% endif %}

{# --- SERVICES --- #}
{% if service or topic == 'services' %}
{% set s = service or "wifi" %}
{% if verbose == 'concise' %}
{{ to_json({"text": s ~ "?", "variables": {"topic": "services"}}) }}
{{ to_json({"text": "Funziona " ~ s ~ "?", "variables": {"topic": "services"}}) }}
{% elif verbose == 'verbose' %}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Mi perdoni, saprebbe dirmi se su questo treno è prevista la connessione " ~ s ~ " per i passeggeri?", "variables": {"topic": "services"}}) }}
    {% else %}
{{ to_json({"text": "Volevo assicurarmi che ci fosse il " ~ s ~ " a bordo, sai com'è, mi serve per lavorare durante il viaggio.", "variables": {"topic": "services"}}) }}
    {% endif %}
{% else %} {# standard #}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Sarebbe così gentile da dirmi se è presente il " ~ s ~ "?", "variables": {"topic": "services"}}) }}
    {% else %} {# neutral #}
{{ to_json({"text": "C'è il " ~ s ~ " a bordo?", "variables": {"topic": "services"}}) }}
{{ to_json({"text": "Il treno ha " ~ s ~ "?", "variables": {"topic": "services"}}) }}
    {% endif %}
{% endif %}
{% endif %}

{# --- GENERAL QA --- #}
{% if topic == 'refunds' %}
    {% if verbose == 'concise' %}
{{ to_json({"text": "Rimborsi?", "variables": {"topic": "refunds"}}) }}
    {% elif verbose == 'verbose' %}
{{ to_json({"text": "Dato che i piani sono cambiati, mi servirebbe sapere con precisione come fare per avere indietro i miei soldi.", "variables": {"topic": "refunds"}}) }}
    {% else %}
{{ to_json({"text": "Qual è la politica rimborsi?", "variables": {"topic": "refunds"}}) }}
    {% endif %}
{% endif %}

{% if topic == 'delay' or topic == 'delays' %}
{{ to_json({"text": "Se il treno è in ritardo?", "variables": {"topic": "delays"}}) }}
    {% if verbose == 'verbose' %}
{{ to_json({"text": "Vorrei sapere cosa succede se il treno dovesse fare ritardo, ci sono delle tutele per noi viaggiatori?", "variables": {"topic": "delays"}}) }}
    {% endif %}
{% endif %}

{% if topic == 'strike' or topic == 'strikes' %}
{{ to_json({"text": "Cosa succede in caso di sciopero?", "variables": {"topic": "strikes"}}) }}
    {% if verbose == 'verbose' %}
{{ to_json({"text": "Dato che si sente parlare di agitazioni, volevo capire meglio come comportarmi se ci fosse uno sciopero dei treni proprio quel giorno.", "variables": {"topic": "strikes"}}) }}
    {% endif %}
{% endif %}

{# --- DYNAMIC PASS-THROUGH (from JSON dataset) --- #}
{% if question %}
{{ to_json({"text": question, "variables": {"topic": topic or "general"}}) }}
{% endif %}
