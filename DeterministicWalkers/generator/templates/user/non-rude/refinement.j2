{# VARIABLES: train, class, aspect, rudeness, verbose, position_word, count #}

{# --- PASSENGERS --- #}
{% if aspect == "passengers" %}
{% if verbose == 'concise' %}
{{ to_json({"text": count|string, "variables": {"refinement": "passengers", "count": count}}) }}
{% elif verbose == 'verbose' %}
    {% if rudeness == 'polite' %}
        {% set p_word = "persona" if count == 1 else "persone" %}
{{ to_json({"text": "Viaggiamo in " ~ count ~ " " ~ p_word ~ ", se non le crea problemi.", "variables": {"refinement": "passengers", "count": count}}) }}
{{ to_json({"text": "Siamo in " ~ count ~ " in totale, spero ci siano posti disponibili.", "variables": {"refinement": "passengers", "count": count}}) }}
    {% else %}
        {% set p_word = "persona" if count == 1 else "persone" %}
{{ to_json({"text": "Siamo " ~ count ~ " " ~ p_word ~ " in tutto per questo viaggio.", "variables": {"refinement": "passengers", "count": count}}) }}
{{ to_json({"text": "In " ~ count ~ ", e vorremmo partire il prima possibile.", "variables": {"refinement": "passengers", "count": count}}) }}
    {% endif %}
{% else %} {# standard #}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Siamo in " ~ count, "variables": {"refinement": "passengers", "count": count}}) }}
        {% set p_word = "passeggero" if count == 1 else "passeggeri" %}
{{ to_json({"text": count ~ " " ~ p_word ~ ", grazie", "variables": {"refinement": "passengers", "count": count}}) }}
    {% else %} {# neutral #}
{{ to_json({"text": count|string, "variables": {"refinement": "passengers", "count": count}}) }}
{{ to_json({"text": "Siamo in " ~ count, "variables": {"refinement": "passengers", "count": count}}) }}
{{ to_json({"text": "In " ~ count, "variables": {"refinement": "passengers", "count": count}}) }}
    {% endif %}
{% endif %}
{% endif %}

{# --- TIME / TRAIN SELECTION --- #}
{% if aspect == "train" %}
{% if verbose == 'concise' %}
{{ to_json({"text": train.dep, "variables": {"refinement": "time"}}) }}
{{ to_json({"text": "Quello lì", "variables": {"refinement": "ordinal"}}) }}
{% elif verbose == 'verbose' %}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Le dispiacerebbe selezionare quello delle " ~ train.dep ~ "? Mi sembra l'orario più comodo per me.", "variables": {"refinement": "time"}}) }}
{{ to_json({"text": "Preferirei gentilmente il treno delle " ~ train.dep ~ ", se non è un problema per lei.", "variables": {"refinement": "time"}}) }}
    {% else %}
{{ to_json({"text": "Prendo quello delle " ~ train.dep ~ ", così arrivo a destinazione in tempo per i miei impegni.", "variables": {"refinement": "time"}}) }}
{{ to_json({"text": "Voglio prendere il treno delle " ~ train.dep ~ " perché mi sembra la soluzione migliore tra quelle proposte.", "variables": {"refinement": "time"}}) }}
    {% endif %}
{% else %} {# standard #}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Le dispiacerebbe selezionare quello delle " ~ train.dep ~ "?", "variables": {"refinement": "time"}}) }}
{{ to_json({"text": "Preferirei gentilmente il treno delle " ~ train.dep, "variables": {"refinement": "time"}}) }}
    {% else %} {# neutral #}
{{ to_json({"text": "No, preferisco quello delle " ~ train.dep, "variables": {"refinement": "time"}}) }}
{{ to_json({"text": "Voglio prendere il treno delle " ~ train.dep, "variables": {"refinement": "time"}}) }}
    {% endif %}
{% endif %}

{# Ordinal-based #}
{% if position_word %}
{% if verbose == 'concise' %}
{{ to_json({"text": position_word, "variables": {"refinement": "ordinal"}}) }}
{% elif verbose == 'verbose' %}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Sceglierei il " ~ position_word ~ " se possibile, mi sembra proprio quello giusto.", "variables": {"refinement": "ordinal"}}) }}
    {% else %}
{{ to_json({"text": "Voglio proprio il " ~ position_word ~ " della lista, grazie per l'aiuto.", "variables": {"refinement": "ordinal"}}) }}
    {% endif %}
{% else %} {# standard #}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Sceglierei il " ~ position_word ~ " se possibile", "variables": {"refinement": "ordinal"}}) }}
{{ to_json({"text": "Puntiamo sul " ~ position_word ~ ", grazie", "variables": {"refinement": "ordinal"}}) }}
    {% else %} {# neutral #}
{{ to_json({"text": "Prendo il " ~ position_word, "variables": {"refinement": "ordinal"}}) }}
{{ to_json({"text": "Il " ~ position_word, "variables": {"refinement": "ordinal"}}) }}
    {% endif %}
{% endif %}
{% endif %}
{% endif %}

{# --- TRAIN + CLASS SELECTION --- #}
{% if aspect == "train_plus_class" %}
{% if verbose == 'concise' %}
{{ to_json({"text": position_word ~ " in " ~ class_name, "variables": {"refinement": "train_plus_class", "class": class_name}}) }}
{% elif verbose == 'verbose' %}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Prenderei gentilmente il " ~ position_word ~ " treno, quello delle " ~ train.dep ~ ", viaggiando in " ~ class_name ~ ".", "variables": {"refinement": "train_plus_class", "class": class_name}}) }}
{{ to_json({"text": "Le chiederei di selezionare il " ~ position_word ~ " treno in " ~ class_name ~ ", grazie mille.", "variables": {"refinement": "train_plus_class", "class": class_name}}) }}
    {% else %}
{{ to_json({"text": "Voglio il " ~ position_word ~ " treno della lista e vorrei viaggiare in " ~ class_name ~ ".", "variables": {"refinement": "train_plus_class", "class": class_name}}) }}
{{ to_json({"text": "Scelgo il " ~ position_word ~ " treno, quello delle " ~ train.dep ~ ", in " ~ class_name ~ ".", "variables": {"refinement": "train_plus_class", "class": class_name}}) }}
    {% endif %}
{% else %} {# standard #}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Il " ~ position_word ~ " treno in " ~ class_name ~ ", per favore.", "variables": {"refinement": "train_plus_class", "class": class_name}}) }}
{{ to_json({"text": "Prenderei il " ~ position_word ~ " in " ~ class_name ~ ", grazie.", "variables": {"refinement": "train_plus_class", "class": class_name}}) }}
    {% else %} {# neutral #}
{{ to_json({"text": "Il " ~ position_word ~ " treno in " ~ class_name, "variables": {"refinement": "train_plus_class", "class": class_name}}) }}
{{ to_json({"text": "Prendo il " ~ position_word ~ " in " ~ class_name, "variables": {"refinement": "train_plus_class", "class": class_name}}) }}
{{ to_json({"text": "Il " ~ position_word ~ " delle " ~ train.dep ~ " in " ~ class_name, "variables": {"refinement": "train_plus_class", "class": class_name}}) }}
    {% endif %}
{% endif %}
{% endif %}

{# --- CLASS SELECTION --- #}
{% if aspect == "class" %}
{% if verbose == 'concise' %}
{{ to_json({"text": class, "variables": {"refinement": "class"}}) }}
{% elif verbose == 'verbose' %}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Viaggerei volentieri in " ~ class ~ ", se ci fosse ancora disponibilità.", "variables": {"refinement": "class"}}) }}
    {% else %}
{{ to_json({"text": "Ho deciso che viaggerò in " ~ class ~ ", credo sia la scelta più equilibrata.", "variables": {"refinement": "class"}}) }}
    {% endif %}
{% else %} {# standard #}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "In " ~ class ~ ", se possibile, grazie", "variables": {"refinement": "class"}}) }}
    {% else %} {# neutral #}
{{ to_json({"text": "Prendo la " ~ class, "variables": {"refinement": "class"}}) }}
{{ to_json({"text": "Preferisco la " ~ class, "variables": {"refinement": "class"}}) }}
    {% endif %}
{% endif %}
{% endif %}

{# --- SEAT SELECTION --- #}
{% if aspect == "seat" %}
{% if verbose == 'concise' %}
{{ to_json({"text": "Finestrino", "variables": {"refinement": "seat", "seat": "window"}}) }}
{{ to_json({"text": "Corridoio", "variables": {"refinement": "seat", "seat": "aisle"}}) }}
{% elif verbose == 'verbose' %}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Preferirei gentilmente il finestrino, così posso godermi il panorama.", "variables": {"refinement": "seat", "seat": "window"}}) }}
{{ to_json({"text": "Sceglierei il corridoio, grazie, per stare un po' più comodo.", "variables": {"refinement": "seat", "seat": "aisle"}}) }}
    {% else %}
{{ to_json({"text": "Vorrei il finestrino perché mi piace guardare fuori durante il viaggio.", "variables": {"refinement": "seat", "seat": "window"}}) }}
{{ to_json({"text": "Meglio il corridoio, così posso alzarmi più facilmente se serve.", "variables": {"refinement": "seat", "seat": "aisle"}}) }}
    {% endif %}
{% else %} {# standard #}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Preferirei gentilmente il finestrino", "variables": {"refinement": "seat", "seat": "window"}}) }}
{{ to_json({"text": "Sceglierei il corridoio, grazie", "variables": {"refinement": "seat", "seat": "aisle"}}) }}
    {% else %} {# neutral #}
{{ to_json({"text": "Vorrei il finestrino", "variables": {"refinement": "seat", "seat": "window"}}) }}
{{ to_json({"text": "Finestrino, grazie", "variables": {"refinement": "seat", "seat": "window"}}) }}
{{ to_json({"text": "Preferisco il corridoio", "variables": {"refinement": "seat", "seat": "aisle"}}) }}
{{ to_json({"text": "Corridoio, per favore", "variables": {"refinement": "seat", "seat": "aisle"}}) }}
    {% endif %}
{% endif %}
{% endif %}

{# --- SEAT MULTISELECT (Multi-passenger) --- #}
{% if aspect == "seat_multiselect" %}
{% if verbose == 'concise' %}
{{ to_json({"text": "4A e 4B", "variables": {"refinement": "seat_multiselect", "seats": "4A,4B"}}) }}
{{ to_json({"text": "Due posti finestrino", "variables": {"refinement": "seat_multiselect", "seats": "4A,4B"}}) }}
{% elif verbose == 'verbose' %}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Preferiremmo gentilmente i posti 4A e 4B in carrozza 4, se sono ancora disponibili.", "variables": {"refinement": "seat_multiselect", "seats": "4A,4B", "carriage": 4}}) }}
{{ to_json({"text": "Scegliamo i posti 4A e 4B, grazie mille per la pazienza.", "variables": {"refinement": "seat_multiselect", "seats": "4A,4B", "carriage": 4}}) }}
    {% else %}
{{ to_json({"text": "Ho selezionato i posti 4A e 4B in carrozza 4, quello che vedete sullo schermo.", "variables": {"refinement": "seat_multiselect", "seats": "4A,4B", "carriage": 4}}) }}
{{ to_json({"text": "Prendiamo 4A e 4B, così stiamo vicini durante il viaggio.", "variables": {"refinement": "seat_multiselect", "seats": "4A,4B", "carriage": 4}}) }}
    {% endif %}
{% else %} {# standard #}
    {% if rudeness == 'polite' %}
{{ to_json({"text": "Preferiremmo i posti 4A e 4B in carrozza 4", "variables": {"refinement": "seat_multiselect", "seats": "4A,4B", "carriage": 4}}) }}
{{ to_json({"text": "Scegliamo 4A e 4B, grazie", "variables": {"refinement": "seat_multiselect", "seats": "4A,4B", "carriage": 4}}) }}
    {% else %} {# neutral #}
{{ to_json({"text": "Ho scelto 4A e 4B", "variables": {"refinement": "seat_multiselect", "seats": "4A,4B", "carriage": 4}}) }}
{{ to_json({"text": "Prendiamo 4A e 4B in carrozza 4", "variables": {"refinement": "seat_multiselect", "seats": "4A,4B", "carriage": 4}}) }}
{{ to_json({"text": "I posti 4A e 4B", "variables": {"refinement": "seat_multiselect", "seats": "4A,4B", "carriage": 4}}) }}
    {% endif %}
{% endif %}
{% endif %}
