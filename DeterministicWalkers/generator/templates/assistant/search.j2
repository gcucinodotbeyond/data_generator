{# VARIABLES: category (required), plus context-specific vars #}

{# --- SEARCHING --- #}
{%- if category == "searching" %}
    {{ to_json({"text": "Sto cercando...", "variables": {}}) }}
    {{ to_json({"text": "Un attimo, controllo subito.", "variables": {}}) }}
    {{ to_json({"text": "Verifico la disponibilità...", "variables": {}}) }}
    {{ to_json({"text": "Controllo cosa ho trovato...", "variables": {}}) }}
    {{ to_json({"text": "Dammi un secondo per cercare.", "variables": {}}) }}
    {{ to_json({"text": "Interrrogo il database...", "variables": {}}) }}
    {{ to_json({"text": "Vediamo quali treni ci sono.", "variables": {}}) }}
    {{ to_json({"text": "Ricerca in corso...", "variables": {}}) }}
{%- endif %}

{# --- SEARCH SUCCESS --- #}
{%- if category == "search_success" %}
    {# Requires: n_trains, destination, first_dep #}
    {%- if n_trains == 1 %}
        {{ to_json({"text": "😊 Ho trovato una soluzione per " ~ destination ~ ". Parte alle " ~ first_dep ~ ".", "variables": {}}) }}
        {{ to_json({"text": "Ecco qui! C'è un treno per " ~ destination ~ " alle " ~ first_dep ~ ".", "variables": {}}) }}
        {{ to_json({"text": "Ho trovato un'opzione. Parte alle " ~ first_dep ~ ". Ti va bene?", "variables": {}}) }}
        {{ to_json({"text": "Trovato! Un treno per " ~ destination ~ " in partenza alle " ~ first_dep ~ ".", "variables": {}}) }}
        {{ to_json({"text": "C'è una soluzione perfetta: partenza alle " ~ first_dep ~ ".", "variables": {}}) }}
        {{ to_json({"text": "Eccolo: treno per " ~ destination ~ " alle " ~ first_dep ~ ".", "variables": {}}) }}
    {%- else %}
        {{ to_json({"text": "😊 Ho trovato " ~ n_trains ~ " soluzioni. La prima per " ~ destination ~ " parte alle " ~ first_dep ~ ".", "variables": {}}) }}
        {{ to_json({"text": "Ecco qui! Ci sono " ~ n_trains ~ " treni per " ~ destination ~ ". Il primo è alle " ~ first_dep ~ ".", "variables": {}}) }}
        {{ to_json({"text": "🙂 Ho trovato diverse opzioni. La prima parte alle " ~ first_dep ~ ".", "variables": {}}) }}
        {{ to_json({"text": "Ottime notizie, ci sono " ~ n_trains ~ " alternative. La prima parte alle " ~ first_dep ~ ".", "variables": {}}) }}
        {{ to_json({"text": "Ho " ~ n_trains ~ " possibilità per te. Quale preferisci?", "variables": {}}) }}
        {{ to_json({"text": "Ci sono diverse soluzioni. Preferisci quella delle " ~ first_dep ~ " o un'altra?", "variables": {}}) }}
        {{ to_json({"text": "Ho " ~ n_trains ~ " opzioni disponibili. La più veloce parte alle " ~ first_dep ~ ".", "variables": {}}) }}
        {{ to_json({"text": "Trovate " ~ n_trains ~ " corse per " ~ destination ~ ". Si inizia con quella delle " ~ first_dep ~ ".", "variables": {}}) }}
        {{ to_json({"text": "Vedo " ~ n_trains ~ " treni. Il prossimo parte alle " ~ first_dep ~ ".", "variables": {}}) }}
    {%- endif %}
{%- endif %}

{# --- SEARCH EMPTY --- #}
{%- if category == "search_empty" %}
    {# Requires: destination #}
    {{ to_json({"text": "😔 Non ho trovato treni per " ~ destination ~ ".", "variables": {}}) }}
    {{ to_json({"text": "Mi dispiace, non ci sono soluzioni per " ~ destination ~ " in questo momento.", "variables": {}}) }}
    {{ to_json({"text": "😔 Nessun treno trovato. Vuoi provare un altro orario?", "variables": {}}) }}
    {{ to_json({"text": "Purtroppo non risulta nulla per " ~ destination ~ ". Proviamo a cambiare orario?", "variables": {}}) }}
    {{ to_json({"text": "Non vedo treni disponibili. Vuoi cercare per un'altra destinazione?", "variables": {}}) }}
    {{ to_json({"text": "Niente da fare, la ricerca non ha dato risultati per " ~ destination ~ ".", "variables": {}}) }}
    {{ to_json({"text": "Spiacente, nessun collegamento trovato al momento.", "variables": {}}) }}
{%- endif %}

{# --- ASK PASSENGERS --- #}
{%- if category == "ask_passengers" %}
    {{ to_json({"text": "Per quanti passeggeri devo cercare? 😊", "variables": {}}) }}
    {{ to_json({"text": "In quanti siete?", "variables": {}}) }}
    {{ to_json({"text": "Per quante persone?", "variables": {}}) }}
    {{ to_json({"text": "Quanti passeggeri viaggiano?", "variables": {}}) }}
    {{ to_json({"text": "Quanti siamo?", "variables": {}}) }}
    {{ to_json({"text": "Numero di viaggiatori?", "variables": {}}) }}
    {{ to_json({"text": "Per quante persone prenoto?", "variables": {}}) }}
    {{ to_json({"text": "Quanti biglietti servono?", "variables": {}}) }}
{%- endif %}

{# --- DISABILITY ACK --- #}
{%- if category == "disability_ack" %}
    {%- if disability_type == "wheelchair" %}
        {{ to_json({"text": "Verificherò la disponibilità di posti per sedia a rotelle e l'assistenza per la salita/discesa. Quanti viaggiatori siete?", "variables": {}}) }}
        {{ to_json({"text": "Cerco subito posti accessibili per sedia a rotelle. In quanti viaggiate?", "variables": {}}) }}
        {{ to_json({"text": "D'accordo, filtro per accessibilità sedia a rotelle. Quante persone?", "variables": {}}) }}
    {%- elif disability_type in ["motor_ambulatory", "elderly", "pregnant"] %}
        {{ to_json({"text": "Cercherò soluzioni con il minor numero di cambi e vicine ai servizi. Quanti siete?", "variables": {}}) }}
        {{ to_json({"text": "Tengo conto delle esigenze di mobilità. Quanti passeggeri?", "variables": {}}) }}
        {{ to_json({"text": "Ok, cerco soluzioni comode e accessibili. In quanti siete?", "variables": {}}) }}
    {%- elif disability_type == "visual" %}
        {{ to_json({"text": "Ti descriverò, se vuoi, ogni dettaglio del viaggio e delle stazioni. Quante persone partono?", "variables": {}}) }}
        {{ to_json({"text": "Ricevuto. Ti fornirò assistenza vocale per ogni dettaglio. Quanti siete?", "variables": {}}) }}
    {%- elif disability_type == "hearing" %}
        {{ to_json({"text": "Riceverai tutte le conferme scritte e visive necessarie. In quanti siete?", "variables": {}}) }}
        {{ to_json({"text": "Certamente, tutto sarà comunicato via testo sullo schermo. Quanti viaggiatori?", "variables": {}}) }}
    {%- elif disability_type == "cognitive" %}
        {{ to_json({"text": "Ti fornirò indicazioni chiare e semplici passo dopo passo. Quanti siete?", "variables": {}}) }}
        {{ to_json({"text": "Va bene, useremo istruzioni semplificate. In quanti partite?", "variables": {}}) }}
    {%- else %}
        {{ to_json({"text": "Certamente, annotato. Quanti viaggiatori siete?", "variables": {}}) }}
        {{ to_json({"text": "Capito, tengo conto della richiesta. Quanti passeggeri?", "variables": {}}) }}
    {%- endif %}
{%- endif %}
