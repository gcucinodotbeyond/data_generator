{# VARIABLES: destination, time, class_type, rudeness, verbose #}

{%- set affirmatives = ["Sì", "Si", "Certamente", "Certo", "Va bene", "Ok", "Okay", "D'accordo", "Affermativo", "Perfetto", "Ottimo"] -%}
{%- set procedurals = ["Procedi", "Vai avanti", "Confermo", "Prenota", "Acquista", "Fallo"] -%}

{# --- SIMPLE AFFIRMATIVE --- #}
{% if verbose == 'concise' %}
    {% for aff in ["Sì", "Ok", "Certamente"] %}
{{ to_json({"text": aff, "variables": {}}) }}
    {% endfor %}
{% elif verbose == 'verbose' %}
    {%- if rudeness == 'polite' %}
{{ to_json({"text": "Sì, direi che è perfetto, procediamo pure come suggerito. La ringrazio molto.", "variables": {}}) }}
{{ to_json({"text": "Certamente, mi sembra un'ottima soluzione per il mio viaggio. Mi aiuti con la prenotazione?", "variables": {}}) }}
    {%- elif rudeness == 'rude' %}
{{ to_json({"text": "E va bene, muoviti a fare questo biglietto che non ho tutto il giorno per stare qui.", "variables": {}}) }}
{{ to_json({"text": "Ok, basta che finiamo in fretta. Non stare a sprecare altro tempo.", "variables": {}}) }}
    {%- else %}
{{ to_json({"text": "Sì, va benissimo così, è proprio quello che stavo cercando per oggi.", "variables": {}}) }}
{{ to_json({"text": "D'accordo, procediamo pure con questa opzione che mi sembra la migliore.", "variables": {}}) }}
    {%- endif %}
{% else %} {# standard #}
    {% if rudeness == 'rude' %}
        {% for aff in ["Ok", "Si", "Vbb"] %}
{{ to_json({"text": aff, "variables": {}}) }}
        {% endfor %}
    {% elif rudeness == 'polite' %}
        {% for aff in affirmatives %}
{{ to_json({"text": aff ~ " grazie", "variables": {}}) }}
{{ to_json({"text": "Certamente, proceda pure", "variables": {}}) }}
        {% endfor %}
    {% else %} {# neutral #}
        {% for aff in affirmatives %}
{{ to_json({"text": aff, "variables": {}}) }}
        {% endfor %}
    {% endif %}
{% endif %}

{# --- AFFIRMATIVE + PROCEDURAL --- #}
{% if verbose != 'concise' and rudeness != 'rude' %}
    {% for aff in affirmatives %}
    {% for proc in procedurals %}
    {% if rudeness == 'polite' %}
{{ to_json({"text": aff ~ ", " ~ proc ~ " pure, grazie", "variables": {}}) }}
    {% else %}
{{ to_json({"text": aff ~ ", " ~ proc, "variables": {}}) }}
{{ to_json({"text": aff ~ " " ~ proc, "variables": {}}) }}
    {% endif %}
    {% endfor %}
    {% endfor %}
{% endif %}

{# --- BASE CONFIRMATIONS --- #}
{% if verbose != 'concise' %}
    {% if rudeness == 'rude' %}
        {% for ok in ["Vabbè", "Ok", "Si", "Procedi", "Muoviti"] %}
{{ to_json({"text": ok, "variables": {}}) }}
        {% endfor %}
    {% elif rudeness == 'polite' %}
        {% for ok in ["Sì, la ringrazio", "Molto bene, proceda", "Perfetto, va benissimo"] %}
{{ to_json({"text": ok, "variables": {}}) }}
        {% endfor %}
    {% else %} {# neutral #}
        {% for ok in ["Sì", "Perfetto", "Va bene", "Confermo", "Ok grazie"] %}
{{ to_json({"text": ok, "variables": {}}) }}
        {% endfor %}
    {% endif %}
{% endif %}

{# --- CONTEXTUAL CONFIRMATION (Simulating responding to a proposal) --- #}
{# "Va bene quello delle 8:00" #}
{% if time %}
{{ to_json({"text": "Va bene quello delle " ~ time, "variables": {"time": time}}) }}
    {% if verbose != 'concise' %}
{{ to_json({"text": "Prendo quello delle " ~ time, "variables": {"time": time}}) }}
{{ to_json({"text": "Ok per le " ~ time, "variables": {"time": time}}) }}
    {% endif %}
{% endif %}

{% if destination %}
{{ to_json({"text": "Sì, per " ~ destination ~ " va bene", "variables": {"destination": destination}}) }}
    {% if verbose != 'concise' %}
{{ to_json({"text": "Confermo " ~ destination, "variables": {"destination": destination}}) }}
    {% endif %}
{% endif %}

{% if class %}
{{ to_json({"text": "In " ~ class, "variables": {"class": class}}) }}
    {% if verbose != 'concise' %}
{{ to_json({"text": "Va bene in " ~ class, "variables": {"class": class}}) }}
{{ to_json({"text": "Ok " ~ class, "variables": {"class": class}}) }}
    {% endif %}
{% endif %}
